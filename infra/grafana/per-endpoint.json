{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Azure Monitor Prometheus",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "title": "DDOS Load Test — Per Endpoint",
  "uid": "ddos-endpoints",
  "tags": ["ddos"],
  "timezone": "browser",
  "schemaVersion": 38,
  "refresh": "10s",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "label": "Datasource"
      },
      {
        "name": "runid",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "query": "label_values(k6_http_reqs_total, runid)",
        "label": "Run ID",
        "multi": false,
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "endpoint",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "query": "label_values(k6_http_reqs_total{runid=~\"$runid\"}, endpoint)",
        "label": "Endpoint",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "refresh": 2
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "RPS by Endpoint",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "targets": [
        {
          "expr": "sum by (endpoint)(rate(k6_http_reqs_total{runid=~\"$runid\", endpoint=~\"$endpoint\"}[30s]))",
          "legendFormat": "{{endpoint}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Error Rate by Endpoint (%)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "percent" } },
      "targets": [
        {
          "expr": "100 * avg by (endpoint)(k6_http_req_failed_rate{runid=~\"$runid\", endpoint=~\"$endpoint\"})",
          "legendFormat": "{{endpoint}} errors",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "p95 Latency by Endpoint",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "ms" } },
      "targets": [
        {
          "expr": "avg by (endpoint)(k6_http_req_duration_p95{runid=~\"$runid\", endpoint=~\"$endpoint\"})",
          "legendFormat": "{{endpoint}} p95",
          "refId": "A"
        },
        {
          "expr": "avg by (endpoint)(k6_http_req_duration_p99{runid=~\"$runid\", endpoint=~\"$endpoint\"})",
          "legendFormat": "{{endpoint}} p99",
          "refId": "B"
        }
      ]
    },
    {
      "id": 4,
      "title": "Data Sent/s by Endpoint",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "Bps" } },
      "targets": [
        {
          "expr": "sum by (endpoint)(rate(k6_data_sent_total{runid=~\"$runid\"}[30s]))",
          "legendFormat": "{{endpoint}} sent",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Status Codes by Endpoint",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "targets": [
        {
          "expr": "sum by (endpoint, status)(rate(k6_http_reqs_total{runid=~\"$runid\", endpoint=~\"$endpoint\"}[30s]))",
          "legendFormat": "{{endpoint}} {{status}}",
          "refId": "A"
        }
      ]
    }
  ],
  "time": { "from": "now-30m", "to": "now" }
}
