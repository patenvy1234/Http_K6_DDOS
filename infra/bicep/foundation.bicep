// foundation.bicep — Phase 1 of the two-phase per-run deployment.
//
// Creates everything that must exist BEFORE cloud-init can be rendered:
//   • User-Assigned Managed Identity (UAMI)
//   • Storage account + blob container (profile.json / bundle.tar.gz)
//   • Role: UAMI → Storage Blob Data Reader (run RG scope)
//   • Cross-RG role: UAMI → Monitoring Metrics Publisher on the DCR
//
// Outputs: uamiResourceId, uamiClientId, uamiPrincipalId,
//          storageAccountName, blobContainerName
//
// The Go controller reads these outputs, renders cloud-init with the known
// storage account name, then calls fleet.bicep.

targetScope = 'resourceGroup'

// ---------------------------------------------------------------------------
// Parameters
// ---------------------------------------------------------------------------

@description('Short run identifier used in resource names.')
@minLength(3)
@maxLength(48)
param runName string

@description('8-character suffix generated by the Go controller per run.')
@minLength(6)
@maxLength(12)
param runSuffix string

@description('RFC3339 timestamp for the deadman cleanup tag.')
param autoDeleteAt string

@description('Owner identifier (operator email) for the auto-delete-at tag.')
param owner string = ''

@description('Maximum VM count across all regions — stored as a tag for the scaler.')
@minValue(1)
@maxValue(500)
param maxVMCount int

@description('Name of the persistent observability resource group.')
param observabilityResourceGroup string

@description('Name of the Data Collection Rule inside the observability RG.')
param dcrName string

@description('Object ID of the operator (signed-in user) that needs to upload the bundle via OAuth.')
param deployerObjectId string

// ---------------------------------------------------------------------------
// Tags applied to every resource (deadman reads purpose + auto-delete-at)
// ---------------------------------------------------------------------------

var tags = {
  purpose: 'ddos-loadgen'
  runId: runSuffix
  runName: runName
  'auto-delete-at': autoDeleteAt
  owner: owner
  managedBy: 'ddos-cli'
  maxVMCount: string(maxVMCount)
}

// ---------------------------------------------------------------------------
// 1. User-Assigned Managed Identity
// ---------------------------------------------------------------------------

resource uami 'Microsoft.ManagedIdentity/userAssignedIdentities@2023-01-31' = {
  name: 'ddos-${runSuffix}-uami'
  location: resourceGroup().location
  tags: tags
}

// ---------------------------------------------------------------------------
// 2. Storage account + blob container
// ---------------------------------------------------------------------------

var storageName = take('ddos${runSuffix}${uniqueString(resourceGroup().id)}', 24)

resource storage 'Microsoft.Storage/storageAccounts@2023-05-01' = {
  name: storageName
  location: resourceGroup().location
  tags: tags
  sku: { name: 'Standard_LRS' }
  kind: 'StorageV2'
  properties: {
    allowBlobPublicAccess: false
    allowSharedKeyAccess: false      // OAuth/AAD only; policy denies shared keys
    minimumTlsVersion: 'TLS1_2'
    supportsHttpsTrafficOnly: true
    publicNetworkAccess: 'Enabled'
  }
}

resource blobService 'Microsoft.Storage/storageAccounts/blobServices@2023-05-01' = {
  parent: storage
  name: 'default'
}

resource runContainer 'Microsoft.Storage/storageAccounts/blobServices/containers@2023-05-01' = {
  parent: blobService
  name: 'ddos-run'
  properties: {
    publicAccess: 'None'
  }
}

// ---------------------------------------------------------------------------
// 3. Role: UAMI → Storage Blob Data Reader
// ---------------------------------------------------------------------------

var roleStorageBlobDataReader = subscriptionResourceId(
  'Microsoft.Authorization/roleDefinitions',
  '2a2b9908-6ea1-4ae2-8e65-a410df84e7d1'
)

resource storageRoleAssign 'Microsoft.Authorization/roleAssignments@2022-04-01' = {
  scope: storage
  name: guid(storage.id, uami.id, 'storageBlobDataReader')
  properties: {
    roleDefinitionId: roleStorageBlobDataReader
    principalId: uami.properties.principalId
    principalType: 'ServicePrincipal'
  }
}

// Storage Blob Data Contributor for the operator — required because shared-key
// auth is disabled, so `az storage blob upload --auth-mode login` is the only
// way the controller can push bundle.tar.gz into the run container.
var roleStorageBlobDataContributor = subscriptionResourceId(
  'Microsoft.Authorization/roleDefinitions',
  'ba92f5b4-2d11-453d-a403-e96b0029c9fe'
)

resource deployerStorageRoleAssign 'Microsoft.Authorization/roleAssignments@2022-04-01' = {
  scope: storage
  name: guid(storage.id, deployerObjectId, 'storageBlobDataContributor')
  properties: {
    roleDefinitionId: roleStorageBlobDataContributor
    principalId: deployerObjectId
    principalType: 'User'
  }
}

// ---------------------------------------------------------------------------
// 4. Cross-RG role: UAMI → Monitoring Metrics Publisher on DCR
// ---------------------------------------------------------------------------

module obsRole 'modules/role_dcr.bicep' = {
  scope: resourceGroup(observabilityResourceGroup)
  name: 'role-dcr-${runSuffix}'
  params: {
    dcrName: dcrName
    principalId: uami.properties.principalId
    runSuffix: runSuffix
  }
}

// ---------------------------------------------------------------------------
// Outputs (fed into fleet.bicep parameters and cloud-init rendering)
// ---------------------------------------------------------------------------

output uamiResourceId    string = uami.id
output uamiClientId      string = uami.properties.clientId
output uamiPrincipalId   string = uami.properties.principalId
output storageAccountName string = storage.name
output blobContainerName  string = runContainer.name
